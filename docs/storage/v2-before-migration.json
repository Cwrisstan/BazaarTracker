  "schema": [
    {
      "name": "order_book_levels",
      "sql": "CREATE TABLE order_book_levels (\n                source_updated_ms INTEGER NOT NULL, product_id TEXT NOT NULL,\n                api_side TEXT NOT NULL CHECK(api_side IN ('buy_summary', 'sell_summary')),\n                level_index INTEGER NOT NULL, price_per_unit REAL NOT NULL,\n                amount INTEGER NOT NULL, orders INTEGER NOT NULL,\n                PRIMARY KEY (source_updated_ms, product_id, api_side, level_index),\n                FOREIGN KEY (source_updated_ms, product_id)\n                    REFERENCES quick_status(source_updated_ms, product_id)\n            )",
      "tbl_name": "order_book_levels",
      "type": "table"
    },
    {
      "name": "quick_status",
      "sql": "CREATE TABLE quick_status (\n                source_updated_ms INTEGER NOT NULL REFERENCES snapshots(source_updated_ms),\n                product_id TEXT NOT NULL,\n                sell_price REAL NOT NULL, sell_volume INTEGER NOT NULL, sell_orders INTEGER NOT NULL,\n                buy_price REAL NOT NULL, buy_volume INTEGER NOT NULL, buy_orders INTEGER NOT NULL,\n                sell_moving_week INTEGER NOT NULL, buy_moving_week INTEGER NOT NULL,\n                PRIMARY KEY (source_updated_ms, product_id)\n            )",
      "tbl_name": "quick_status",
      "type": "table"
    },
    {
      "name": "snapshots",
      "sql": "CREATE TABLE snapshots (\n                source_updated_ms INTEGER PRIMARY KEY,\n                collected_at_utc TEXT NOT NULL,\n                product_count INTEGER NOT NULL\n            )",
      "tbl_name": "snapshots",
      "type": "table"
    },
